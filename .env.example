# Supabase PostgreSQL connection string (Transaction or Session pooler / Direct connection)
# Leave blank during local development to automatically use the embedded Postgres (PGlite) database at ./.local-db
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Optional Supabase JS Client keys (for Storage / Realtime / etc.)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
